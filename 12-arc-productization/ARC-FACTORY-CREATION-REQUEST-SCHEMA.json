{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ryz3n://arc-factory-creation-request/v1.1",
  "title": "RYZ3N ARC Factory Creation Request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "requester_role",
    "authorization_state",
    "display_name",
    "repository_class",
    "owner",
    "language",
    "commercial",
    "source_intent",
    "onboarding"
  ],
  "properties": {
    "schema_version": {"const":"1.1"},
    "request_id": {"type":"string","minLength":1},
    "requested_at": {"type":["string","null"]},
    "requester_role": {"enum":["founder","authorized_operator"]},
    "authorization_state": {"const":"explicit"},
    "display_name": {"type":"string","minLength":1},
    "requested_arc_id": {"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9-]*$"},
    "repository_class": {"enum":["ryz3n_owned_product_domain","customer_standalone_domain"]},
    "repository": {
      "type":"object",
      "properties": {
        "preferred_name":{"type":["string","null"]},
        "existing_repository":{"type":["string","null"]},
        "visibility":{"enum":["private","public",null]},
        "creation_required":{"type":["boolean","null"]}
      },
      "additionalProperties":false
    },
    "owner": {
      "type":"object",
      "required":["entity_class","display_name","binding_state"],
      "properties": {
        "entity_class":{"type":"string","minLength":1},
        "display_name":{"type":"string","minLength":1},
        "binding_state":{"enum":["pending_first_contact","bound"]}
      },
      "additionalProperties":false
    },
    "language": {
      "type":"object",
      "required":["primary"],
      "properties": {
        "primary":{"type":"string","minLength":2},
        "secondary":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },
      "additionalProperties":false
    },
    "commercial": {
      "type":"object",
      "required":["tier"],
      "properties": {
        "tier":{"type":"string","minLength":1},
        "pilot_free_months":{"type":["integer","null"],"minimum":0},
        "billing_note":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "source_intent": {
      "type":"object",
      "required":["business_or_domain_label"],
      "properties": {
        "business_or_domain_label":{"type":"string","minLength":1},
        "intended_first_use":{"type":["string","null"]},
        "candidate_hostname":{"type":["string","null"]},
        "candidate_hostname_verification":{"enum":["verified","unverified","not_applicable",null]}
      },
      "additionalProperties":true
    },
    "onboarding": {
      "type":"object",
      "required":[
        "activation_mode",
        "screenshot_required",
        "pairing_code_required",
        "candidate_id_handoff_required",
        "pid_or_pre_id_required"
      ],
      "properties": {
        "primary_channel_preference":{"type":["string","null"]},
        "first_contact_configuration":{"type":["string","null"]},
        "activation_mode":{"const":"armed_first_eligible_inbound_auto_bind"},
        "screenshot_required":{"const":false},
        "pairing_code_required":{"const":false},
        "candidate_id_handoff_required":{"const":false},
        "pid_or_pre_id_required":{"const":false},
        "atomic_claim_required":{"const":true},
        "founder_operator_excluded":{"const":true},
        "canonical_standard":{"const":"12-arc-productization/ARC-DIRECT-FIRST-CONTACT-ACTIVATION-STANDARD.md"}
      },
      "additionalProperties":true
    },
    "side_effect_policy": {
      "type":"object",
      "properties": {
        "repository_creation_authorized":{"type":"boolean"},
        "paid_provider_purchase_authorized":{"type":"boolean"},
        "domain_or_dns_change_authorized":{"type":"boolean"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
