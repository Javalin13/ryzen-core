{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ryz3n://arc-factory-birth-manifest/v1.2",
  "title": "RYZ3N ARC Factory Birth Manifest",
  "type": "object",
  "required": [
    "factory_contract_version",
    "factory_template_version",
    "arc_id",
    "display_name",
    "production_state",
    "source_boundary",
    "owner",
    "language",
    "commercial",
    "runtime",
    "hermetic_seal",
    "visual",
    "registries",
    "maturity",
    "provenance",
    "stages"
  ],
  "properties": {
    "factory_contract_version": {"type":"string","minLength":1},
    "factory_template_version": {"type":"string","minLength":1},
    "arc_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "display_name": {"type":"string","minLength":1},
    "production_state": {"type":"string","minLength":1},
    "source_boundary": {
      "type":"object",
      "required":["class","authoritative_repository","arc_root","repository_creation_mode"],
      "properties": {
        "class":{"enum":["ryz3n_owned_product_domain","customer_standalone_domain"]},
        "authoritative_repository":{"type":"string","minLength":1},
        "arc_root":{"type":"string","minLength":1},
        "repository_creation_mode":{"enum":["factory_created","preexisting_designated","manual_gap_then_adopted"]},
        "domain_or_hostname":{"type":["string","null"]},
        "domain_verification":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "owner": {
      "type":"object",
      "required":["entity_class","binding_status"],
      "properties": {
        "entity_class":{"type":"string","minLength":1},
        "display_name":{"type":["string","null"]},
        "binding_status":{"type":"string","minLength":1}
      },
      "additionalProperties":true
    },
    "language": {
      "type":"object",
      "required":["primary"],
      "properties": {
        "primary":{"type":"string","minLength":2},
        "secondary":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },
      "additionalProperties":false
    },
    "commercial": {"type":"object"},
    "runtime": {
      "type":"object",
      "properties": {
        "status":{"type":"string"},
        "isolation_required":{"type":"boolean"},
        "secrets_outside_git":{"type":"boolean"},
        "unknown_identity_behavior":{"type":"string"},
        "pending_candidate_model":{"type":["string","null"]},
        "model_capacity_pool":{},
        "primary_channel":{},
        "repository_autonomy":{"type":["string","boolean", "null"]},
        "client_installs_prime":{"type":["boolean","null"]}
      },
      "additionalProperties":true
    },
    "hermetic_seal": {
      "type":"object",
      "required":[
        "status",
        "canonical_standard",
        "required_before_runtime_ready",
        "autonomy_rule",
        "safe_shared_writer_required_if_autonomy_granted",
        "maturity_promotion_implied"
      ],
      "properties": {
        "status":{"enum":["inherited_pre_runtime","hardening_in_progress","GREEN","DRIFT","RED"]},
        "contract":{"type":["string","null"]},
        "canonical_standard":{"type":"string","minLength":1},
        "golden_blueprint_amendment":{"type":["string","null"]},
        "required_before_runtime_ready":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "autonomy_rule":{"type":"string","minLength":1},
        "safe_shared_writer_required_if_autonomy_granted":{"type":"boolean"},
        "maturity_promotion_implied":{"const":false}
      },
      "additionalProperties":true
    },
    "visual": {"type":"object"},
    "registries": {"type":"object"},
    "maturity": {"type":"object"},
    "provenance": {"type":"object"},
    "stages": {
      "type":"object",
      "required":["F0_authorization","F1_source_boundary","F2_instance_package","F3_stewardship_registration","F4_runtime_provisioning","F5_owner_binding_first_run","F6_evidence_closeout"],
      "properties": {
        "F0_authorization":{"type":"string"},
        "F1_source_boundary":{"type":"string"},
        "F2_instance_package":{"type":"string"},
        "F3_stewardship_registration":{"type":"string"},
        "F4_runtime_provisioning":{"type":"string"},
        "F5_owner_binding_first_run":{"type":"string"},
        "F6_evidence_closeout":{"type":"string"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":true
}
