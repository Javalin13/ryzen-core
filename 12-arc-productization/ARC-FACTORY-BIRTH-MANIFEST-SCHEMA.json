{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ryz3n://arc-factory-birth-manifest/v1.4",
  "title": "RYZ3N ARC Factory Birth Manifest",
  "type": "object",
  "required": [
    "factory_contract_version",
    "factory_template_version",
    "arc_id",
    "display_name",
    "production_state",
    "source_boundary",
    "owner",
    "language",
    "commercial",
    "runtime",
    "first_contact_activation",
    "hermetic_seal",
    "operator_access",
    "intelligence_policy",
    "visual",
    "registries",
    "maturity",
    "provenance",
    "stages"
  ],
  "properties": {
    "factory_contract_version": {"type":"string","minLength":1},
    "factory_template_version": {"type":"string","minLength":1},
    "arc_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "display_name": {"type":"string","minLength":1},
    "production_state": {"type":"string","minLength":1},
    "source_boundary": {
      "type":"object",
      "required":["class","authoritative_repository","arc_root","repository_creation_mode"],
      "properties": {
        "class":{"enum":["ryz3n_owned_product_domain","customer_standalone_domain"]},
        "authoritative_repository":{"type":"string","minLength":1},
        "arc_root":{"type":"string","minLength":1},
        "repository_creation_mode":{"enum":["factory_created","preexisting_designated","manual_gap_then_adopted"]},
        "domain_or_hostname":{"type":["string","null"]},
        "domain_verification":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "owner": {
      "type":"object",
      "required":["entity_class","binding_status"],
      "properties": {
        "entity_class":{"type":"string","minLength":1},
        "display_name":{"type":["string","null"]},
        "binding_status":{"type":"string","minLength":1}
      },
      "additionalProperties":true
    },
    "language": {
      "type":"object",
      "required":["primary"],
      "properties": {
        "primary":{"type":"string","minLength":2},
        "secondary":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },
      "additionalProperties":false
    },
    "commercial": {"type":"object"},
    "runtime": {
      "type":"object",
      "properties": {
        "status":{"type":"string"},
        "isolation_required":{"type":"boolean"},
        "secrets_outside_git":{"type":"boolean"},
        "unknown_identity_behavior":{"type":"string"},
        "pending_candidate_model":{"const":null},
        "model_capacity_pool":{},
        "primary_channel":{},
        "repository_autonomy":{"type":["string","boolean", "null"]},
        "client_installs_prime":{"type":["boolean","null"]},
        "founder_work_lane":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "first_contact_activation": {
      "type":"object",
      "required":[
        "mode",
        "target_role",
        "manual_pairing_code_required",
        "screenshot_required",
        "candidate_id_handoff_required",
        "pid_or_pre_id_required",
        "runtime_private_identity_allowed",
        "atomic_claim_required",
        "founder_operator_excluded",
        "close_after_successful_claim",
        "ambiguity_policy"
      ],
      "properties": {
        "mode":{"const":"armed_first_eligible_inbound_auto_bind"},
        "target_role":{"type":"string","minLength":1},
        "status":{"enum":["pre_runtime","armed","consumed","closed"]},
        "manual_pairing_code_required":{"const":false},
        "screenshot_required":{"const":false},
        "candidate_id_handoff_required":{"const":false},
        "pid_or_pre_id_required":{"const":false},
        "runtime_private_identity_allowed":{"const":true},
        "atomic_claim_required":{"const":true},
        "founder_operator_excluded":{"const":true},
        "close_after_successful_claim":{"const":true},
        "ambiguity_policy":{"const":"fail_closed_without_id_handoff"},
        "canonical_standard":{"const":"12-arc-productization/ARC-DIRECT-FIRST-CONTACT-ACTIVATION-STANDARD.md"}
      },
      "additionalProperties":true
    },
    "hermetic_seal": {
      "type":"object",
      "required":[
        "status",
        "canonical_standard",
        "required_before_runtime_ready",
        "autonomy_rule",
        "safe_shared_writer_required_if_autonomy_granted",
        "maturity_promotion_implied"
      ],
      "properties": {
        "status":{"enum":["inherited_pre_runtime","hardening_in_progress","GREEN","DRIFT","RED"]},
        "contract":{"type":["string","null"]},
        "canonical_standard":{"type":"string","minLength":1},
        "golden_blueprint_amendment":{"type":["string","null"]},
        "required_before_runtime_ready":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "autonomy_rule":{"type":"string","minLength":1},
        "safe_shared_writer_required_if_autonomy_granted":{"type":"boolean"},
        "maturity_promotion_implied":{"const":false}
      },
      "additionalProperties":true
    },
    "operator_access": {
      "type":"object",
      "required":[
        "founder_operator_role_separate_from_owner",
        "founder_operator_owner_private_memory_access_allowed",
        "founder_operator_cross_arc_private_state_access_allowed",
        "own_repo_write_requires_bounded_safe_writer"
      ],
      "properties": {
        "founder_operator_role_separate_from_owner":{"const":true},
        "founder_operator_owner_private_memory_access_allowed":{"const":false},
        "founder_operator_cross_arc_private_state_access_allowed":{"const":false},
        "own_repo_write_requires_bounded_safe_writer":{"const":true},
        "direct_arc_work_lane":{"type":"string"},
        "prime_role":{"type":"string"}
      },
      "additionalProperties":true
    },
    "intelligence_policy": {
      "type":"object",
      "required":[
        "free_endpoint_required",
        "paid_model_fallback_allowed",
        "autonomous_billing_changes_allowed",
        "autonomous_credit_purchase_allowed",
        "paid_override_authority",
        "deterministic_eol_failover_without_retry_storm"
      ],
      "properties": {
        "free_endpoint_required":{"const":true},
        "paid_model_fallback_allowed":{"const":false},
        "autonomous_billing_changes_allowed":{"const":false},
        "autonomous_credit_purchase_allowed":{"const":false},
        "paid_override_authority":{"const":"founder_explicit_only"},
        "deterministic_eol_failover_without_retry_storm":{"const":true},
        "capability_routing_allowed":{"type":"boolean"},
        "required_media_capabilities":{"type":"object"},
        "canonical_standard":{"type":"string"}
      },
      "additionalProperties":true
    },
    "visual": {"type":"object"},
    "registries": {"type":"object"},
    "maturity": {"type":"object"},
    "provenance": {"type":"object"},
    "stages": {
      "type":"object",
      "required":["F0_authorization","F1_source_boundary","F2_instance_package","F3_stewardship_registration","F4_runtime_provisioning","F5_owner_binding_first_run","F6_evidence_closeout"],
      "properties": {
        "F0_authorization":{"type":"string"},
        "F1_source_boundary":{"type":"string"},
        "F2_instance_package":{"type":"string"},
        "F3_stewardship_registration":{"type":"string"},
        "F4_runtime_provisioning":{"type":"string"},
        "F5_owner_binding_first_run":{"type":"string"},
        "F6_evidence_closeout":{"type":"string"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":true
}
